# Cadena de conexión de PostgreSQL (Neon, Render, Railway, Supabase, etc.)
DATABASE_URL=postgres://usuario:password@host:5432/nombre_bd

# Poner en "false" solo si tu proveedor no requiere SSL (ej. Postgres local)
DATABASE_SSL=true

# JSON completo de la cuenta de servicio de Firebase, en una sola línea.
# Firebase Console → ⚙️ Configuración del proyecto → Cuentas de servicio → Generar nueva clave privada
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...", "...": "..."}

# API key de TomTom (developer.tomtom.com → tu app → API Keys). No pide tarjeta de crédito.
TOMTOM_API_KEY=

# URL del frontend, para configurar CORS correctamente en producción
CLIENT_ORIGIN=http://localhost:5173

PORT=4000
