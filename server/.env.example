# Copia este archivo a `.env` y completa los valores. NO subas `.env` a git.

# Puerto del servidor (opcional; por defecto 4000)
PORT=4000

# Conexión a PostgreSQL (Neon, Render, Railway, local...)
DATABASE_URL=postgres://usuario:password@host:5432/nombre_bd
# Usa "false" solo si tu base local no tiene SSL
DATABASE_SSL=true

# JSON completo de la cuenta de servicio de Firebase, en UNA sola línea
# (Firebase Console → Configuración del proyecto → Cuentas de servicio → Generar clave privada)
FIREBASE_SERVICE_ACCOUNT={}

# Tiempo de traslado con tráfico (TomTom) y geocodificación de direcciones (LocationIQ)
TOMTOM_API_KEY=
LOCATIONIQ_API_KEY=
# Opcionales: tiempo máximo de espera de cada servicio, en milisegundos (por defecto 4000 y 5000)
# TOMTOM_TIMEOUT_MS=4000
# LOCATIONIQ_TIMEOUT_MS=5000

# Orígenes del frontend permitidos por CORS, separados por coma (sin barra final).
# Ej: https://mi-app.vercel.app,https://www.mi-dominio.com
# Si lo dejas vacío se permite cualquier origen (solo recomendable en desarrollo).
CLIENT_ORIGIN=http://localhost:5173
